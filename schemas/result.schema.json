{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoAgent-Bench result",
  "type": "object",
  "required": [
    "status",
    "summary",
    "metrics",
    "artifacts",
    "evidence",
    "limitations"
  ],
  "properties": {
    "status": {
      "enum": [
        "completed",
        "needs_clarification",
        "unavailable",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "readback"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "readback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object"
          },
          "receipt": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "required": [
          "reason_code"
        ]
      }
    }
  ]
}
